@model IEnumerable<HSU_Recommender_system.Models.UniversityRecommendationResult>

@{
    ViewData["Title"] = "My University Matches";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold" style="color: #6f42c1;">Personalized University Recommendations</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <strong>No matches found.</strong> Please ensure you have completed your <a asp-controller="StudentProfile" asp-action="Manage">Academic Profile</a> and that the Admin has added universities to the database.
        </div>
    }
    else
    {
        <!-- CHART.JS VISUALIZATION SECTION -->
        <div class="card shadow-sm border-0 mb-5">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="text-muted fw-bold">Comparative Analytics</h5>
            </div>
            <div class="card-body">
                <div style="height: 350px; width: 100%;">
                    <canvas id="recommendationChart"></canvas>
                </div>
            </div>
        </div>

        <h4 class="mb-3 text-muted">Detailed Breakdown</h4>
        <div class="row g-4">
            @foreach (var result in Model)
            {
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold">@result.University?.Name</h4>
                            <span class="badge fs-6 
                                @(result.Category.Contains("Best Fit") ? "bg-success" : 
                                  result.Category.Contains("Target") ? "bg-warning text-dark" : 
                                  result.Category.Contains("Safe") ? "bg-primary" : "bg-danger")">
                                @result.Category
                            </span>
                        </div>
                        <div class="card-body">
                            <h6 class="text-muted mb-3">@result.Program?.DegreeName | @result.University?.Country</h6>
                            
                            <div class="p-3 mb-3 bg-light rounded border border-light-subtle">
                                <strong>Why recommended:</strong> @result.RecommendationReason
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>Overall Match Score</span>
                                    <span class="fw-bold">@result.OverallScore%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar" style="background-color: #6f42c1; width: @result.OverallScore%" role="progressbar"></div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-6 mb-3">
                                    <span class="d-block text-muted small">Admission Chance</span>
                                    <span class="fw-bold">@result.AdmissionChance%</span>
                                </div>

                                <div class="col-6 mb-3">
                                    <span class="d-block text-muted small">Research Fit Score</span>
                                    <span class="fw-bold">@result.BudgetFit%</span>
                                </div>

                                <div class="col-6">
                                    <span class="d-block text-muted small">RA Chance</span>
                                    <span class="fw-bold text-success">@result.RaChance%</span>
                                </div>
                                <div class="col-6">
                                    <span class="d-block text-muted small">TA Chance</span>
                                    <span class="fw-bold text-success">@result.TaChance%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    @if (Model.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        
        <script>
            const universities = @Html.Raw(Json.Serialize(Model.Select(m => m.University?.Name)));
            const overallScores = @Html.Raw(Json.Serialize(Model.Select(m => m.OverallScore)));
            const admissionChances = @Html.Raw(Json.Serialize(Model.Select(m => m.AdmissionChance)));
            const budgetFits = @Html.Raw(Json.Serialize(Model.Select(m => m.BudgetFit)));

            const ctx = document.getElementById('recommendationChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: universities,
                    datasets: [
                        {
                            label: 'Overall Match (%)',
                            data: overallScores,
                            backgroundColor: '#6f42c1', 
                            borderRadius: 4
                        },
                        {
                            label: 'Admission Chance (%)',
                            data: admissionChances,
                            backgroundColor: '#198754', 
                            borderRadius: 4
                        },
                        {
                            label: 'Budget Fit (%)',
                            data: budgetFits,
                            backgroundColor: '#0dcaf0', 
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: { display: true, text: 'Percentage (%)' }
                        }
                    }
                }
            });
        </script>
    }
}