@model IEnumerable<HSU_Recommender_system.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "User Management Dashboard";
}

<div class="container mt-4">
    <h3 class="mb-4 text-purple" style="color: #6f42c1;">System Access Management</h3>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body bg-light">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>User Email</th>
                        <th>Current Role</th>
                        <th>Access Control</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@user.Email</td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Student</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleAdmin" method="post">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    @if (user.IsAdmin)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Demote to Student</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-success fw-bold">Elevate to Admin</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>