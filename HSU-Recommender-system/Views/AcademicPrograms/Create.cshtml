@model HSU_Recommender_system.Models.AcademicProgram

@{
    ViewData["Title"] = "Add Academic Program";
}

<h2 class="text-purple fw-bold mb-4" style="color: #6f42c1;">Add Academic Program</h2>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body bg-light">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <h5 class="text-muted border-bottom pb-2 mb-3">General Information</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-12 mb-3">
                    <label asp-for="UniversityId" class="form-label fw-bold">Select University</label>
                    <select asp-for="UniversityId" class="form-select" asp-items="ViewBag.UniversityId">
                        <option value="">-- Choose a University --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DegreeName" class="form-label fw-bold"></label>
                    <input asp-for="DegreeName" class="form-control" placeholder="e.g. MS in Computer Science" />
                    <span asp-validation-for="DegreeName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Department" class="form-label fw-bold"></label>
                    <input asp-for="Department" class="form-control" placeholder="e.g. Khoury College of Computer Sciences" />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TotalTuitionFee" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="TotalTuitionFee" class="form-control" type="number" />
                    </div>
                    <span asp-validation-for="TotalTuitionFee" class="text-danger"></span>
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Admissions Criteria</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-3 mb-3">
                    <label asp-for="MinCGPA" class="form-label fw-bold"></label>
                    <input asp-for="MinCGPA" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="MinCGPA" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="MinIELTS" class="form-label fw-bold"></label>
                    <input asp-for="MinIELTS" class="form-control" type="number" step="0.5" />
                    <span asp-validation-for="MinIELTS" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="TargetGREQuant" class="form-label fw-bold"></label>
                    <input asp-for="TargetGREQuant" class="form-control" type="number" placeholder="e.g. 165" />
                    <span asp-validation-for="TargetGREQuant" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsGRERequired" />
                        <label class="form-check-label fw-bold" asp-for="IsGRERequired">
                            @Html.DisplayNameFor(model => model.IsGRERequired)
                        </label>
                    </div>
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Research & Assistantship (OpenAlex Setup)</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="HistoricalRAChance" class="form-label fw-bold"></label>
                    <input asp-for="HistoricalRAChance" class="form-control" type="number" placeholder="%" />
                    <span asp-validation-for="HistoricalRAChance" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="HistoricalTAChance" class="form-label fw-bold"></label>
                    <input asp-for="HistoricalTAChance" class="form-control" type="number" placeholder="%" />
                    <span asp-validation-for="HistoricalTAChance" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ResearchKeywords" class="form-label fw-bold"></label>
                    <input asp-for="ResearchKeywords" class="form-control" placeholder="e.g. Machine Learning, NLP, Cyber" />
                    <span asp-validation-for="ResearchKeywords" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OpenAlexInstitutionId" class="form-label fw-bold"></label>
                    <input asp-for="OpenAlexInstitutionId" class="form-control" placeholder="e.g. ror:https://ror.org/xxxx" />
                    <span asp-validation-for="OpenAlexInstitutionId" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-2">
                <button type="submit" class="btn text-white fw-bold" style="background-color: #6f42c1;">Create Program</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}