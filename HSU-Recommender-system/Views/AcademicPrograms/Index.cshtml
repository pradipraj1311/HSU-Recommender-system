@model IEnumerable<HSU_Recommender_system.Models.AcademicProgram>

@{
    ViewData["Title"] = "Manage Academic Programs";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="text-purple fw-bold mb-0" style="color: #6f42c1;">Manage Academic Programs</h2>
    <a asp-action="Create" class="btn btn-primary fw-bold">
        <i class="bi bi-plus-circle"></i> Add New Program
    </a>
</div>

<div class="table-responsive shadow-sm">
    <table class="table table-hover align-middle bg-white mb-0">
        <thead class="table-dark">
            <tr>
                <th>Degree / Department</th>
                <th>University</th>
                <th>Target GRE (Quant)</th>
                <th>Research Keywords</th>
                <th>RA / TA Chance</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        <span class="fw-bold d-block">@Html.DisplayFor(modelItem => item.DegreeName)</span>
                        <small class="text-muted">@Html.DisplayFor(modelItem => item.Department)</small>
                    </td>
                    <td class="fw-semibold text-primary">
                        @Html.DisplayFor(modelItem => item.University.Name)
                    </td>
                    <td>
                        @if(item.IsGRERequired) {
                            <span class="badge bg-danger">Req: @item.TargetGREQuant</span>
                        } else {
                            <span class="badge bg-success">Optional (Target: @item.TargetGREQuant)</span>
                        }
                    </td>
                    <td>
                        <small class="text-muted">@Html.DisplayFor(modelItem => item.ResearchKeywords)</small>
                    </td>
                    <td>
                        <span class="badge bg-info text-dark">RA: @item.HistoricalRAChance%</span>
                        <span class="badge bg-secondary">TA: @item.HistoricalTAChance%</span>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mb-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger mb-1">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>